{
  "name": [[ symphony_app_slug.removesuffix('[bot]') | to_json ]],
  "url": [[ ("https://github.com/" ~ repo_slug) | to_json ]],
  "description": "Symphony author operations for this repository",
  "public": false,
  "default_events": [],
  "default_permissions": {
    "metadata": "read",
    "contents": "write",
    "actions": "read",
    "pull_requests": "write",
    "issues": "write",
    "checks": "read",
    "statuses": "read",
    "workflows": "write"
  }
}
