name: Symphony Client CI

on:
  push:
    branches: [[ [default_branch] | to_json ]]
  pull_request:
    types: [opened, synchronize, reopened]

permissions:
  contents: read

jobs:
  commands:
    uses: 1000lines/symphony-client-workflows/.github/workflows/symphony-client-commands.yml@main
    with:
      tested-ref: ${{ github.event.pull_request.head.sha || github.sha }}
      commands: >-
        [[ [["bash", "-lc", build_command], ["bash", "-lc", test_command]] | to_json ]]
