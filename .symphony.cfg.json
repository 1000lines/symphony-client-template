{
  "schemaVersion": "symphony-repository/v1",
  "linear": {
    "teamKey": "100"
  },
  "workingDirectory": ".",
  "instructions": [
    "SYMPHONY.md"
  ],
  "commands": {
    "build": [
      [
        "bash",
        "-lc",
        "python3 -m compileall -q tests"
      ]
    ],
    "test": [
      [
        "bash",
        "-lc",
        "package_dir=\"$PWD\"\npython3 -m venv ../.symphony-template-venv\n../.symphony-template-venv/bin/python -m pip install -r tests/requirements.txt\ncd ..\n./.symphony-template-venv/bin/python -m unittest discover -s \"$package_dir/tests\" -v"
      ],
      [
        "node",
        "--test",
        "tests/test-credentials.mjs"
      ]
    ]
  },
  "ci": {
    "requiredChecks": [
      {
        "name": "Client template tests",
        "workflow": ".github/workflows/ci.yml",
        "appId": 15368
      }
    ]
  }
}
